DATABASE_URL=postgresql+psycopg://project3:change-me@localhost:5432/project3

MAX_WEBHOOK_BODY_BYTES=262144
WEBSITE_HMAC_SECRET=replace-with-random-hmac-secret
WEBSITE_HMAC_MAX_SKEW_SECONDS=300
LINKEDIN_BEARER_TOKEN=replace-with-linkedin-like-token
PARTNER_API_KEY=replace-with-partner-api-key

HUBSPOT_SERVICE_KEY=replace-with-hubspot-service-key
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_VERSION=2026-03
HUBSPOT_HTTP_TIMEOUT_SECONDS=30

WORKER_LEASE_SECONDS=900
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_ERROR_BACKOFF_SECONDS=5
CRM_RETRY_DELAY_1_SECONDS=300
CRM_RETRY_DELAY_2_SECONDS=1800
CRM_RETRY_DELAY_3_SECONDS=7200
CRM_RECONCILE_INITIAL_DELAY_SECONDS=15
CRM_RECONCILE_NOT_FOUND_DELAY_2_SECONDS=60
CRM_RECONCILE_NOT_FOUND_DELAY_3_SECONDS=300
CRM_RECONCILE_ERROR_DELAY_1_SECONDS=300
CRM_RECONCILE_ERROR_DELAY_2_SECONDS=1800

CLUSTER_FAILURE_THRESHOLD=5
CLUSTER_FAILURE_WINDOW_SECONDS=600
NOTIFICATION_BATCH_INTERVAL_SECONDS=7200
NOTIFICATION_BATCH_MAX_ITEMS=100
NOTIFICATION_FAILURE_RETRY_SECONDS=300

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=30
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=automation@example.com
SMTP_STARTTLS=true
OPS_EMAIL_TO=ops@example.com
AUTOMATION_EMAIL_TO=automation@example.com
